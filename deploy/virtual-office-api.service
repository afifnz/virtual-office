[Unit]
Description=Agent Office API (Go, read-only Hermes state)
Documentation=https://office.afifnurzein.my.id/api/health
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Binary dipasang oleh deploy/deploy-from-release.sh (atau deploy manual) ke
# ~/.local/bin/office-api. Versi lama berkas ini menunjuk backend/bin/office-api
# dan PORT=8131 — keduanya tidak pernah dipakai produksi, sehingga siapa pun yang
# mengikuti repo akan menghasilkan deployment yang berbeda dari yang berjalan.
#
# WorkingDirectory sengaja hanya $HOME: API tidak membaca berkas relatif, dan
# host yang hanya memasang artefak rilis (tanpa salinan rsync repo) tidak boleh
# gagal start dengan 200/CHDIR.
WorkingDirectory=%h
ExecStart=%h/.local/bin/office-api

Environment=HERMES_HOME=%h/.hermes
Environment=BIND=127.0.0.1
Environment=PORT=8130
# Override tanpa mengedit unit: tulis KEY=value di berkas ini.
EnvironmentFile=-%h/.config/office-api.env
# Restrict the roster without touching the code:
# Environment=PROFILES=default,dev,planner,coder,reviewer,tester,edu

Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=office-api

[Install]
WantedBy=default.target
