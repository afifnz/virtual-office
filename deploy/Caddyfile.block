# Agent Office — Caddy block
#
# Paste inside the site block for office.afifnurzein.my.id, replacing the old
# Python API (127.0.0.1:8130) and /var/www/office. Reload with:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The frontend is a static build (frontend/dist). The API is read-only JSON and
# binds to localhost, so it is only reachable through this proxy.

office.afifnurzein.my.id {
	encode zstd gzip

	# JSON API — Go service on :8131 (the old Python one stayed on :8130)
	handle /api/* {
		reverse_proxy 127.0.0.1:8131 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Static SPA build
	handle {
		root * /var/www/office-v2
		try_files {path} /index.html
		file_server
	}

	# The API is public metadata; keep the usual hardening headers anyway.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Long cache for hashed assets, no cache for the shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@index path / /
	header @index Cache-Control "no-cache"

	log {
		output file /var/log/caddy/office.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}
